# shellcheck shell=bash
# Chapel configuration for ChOp, sourced by the scripts that build or run Chapel code.
#
# ChOp's GPU search only calls its CUDA kernels through C interop, but it sizes its GPU set with
# `here.gpus`, which needs the gpu locale model. Chapel's own NVIDIA codegen needs ptxas, so
# CPU-as-device mode provides the locale model instead: Chapel's GPU code runs on the host, and
# ChOp's CUDA kernels run on the real GPU.
CHAPEL_VERSION=2.10.0
CHPL_HOME="$(realpath .)/chapel-${CHAPEL_VERSION}"
export CHPL_HOME
export CHPL_LLVM=none
export CHPL_COMM=none
export CHPL_LOCALE_MODEL=gpu
export CHPL_GPU=cpu
